<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/blockDay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button style="@style/AppButton"
                android:id="@+id/prevWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prev_week" />

            <TextView
                android:id="@+id/monthLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button style="@style/AppButton"
                android:id="@+id/nextWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_week" />
        </LinearLayout>

        <Button style="@style/AppButton"
            android:id="@+id/weightButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/adjustmentInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/adjustment_hint"
            android:inputType="numberDecimal|numberSigned" />

        <Button style="@style/AppButton"
            android:id="@+id/saveAdjustmentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:textSize="14sp"
            android:text="@string/save" />

        <LinearLayout
            android:id="@+id/dayStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/kcalLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/kcal" />

        <ProgressBar
            android:id="@+id/kcalBar" android:progressTint="?attr/progressKcal" android:progressBackgroundTint="?attr/progressTrack"
            style="?android:attr/progressBarStyleHorizontal" android:minHeight="14dp" android:progressDrawable="@drawable/progress_rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/kcalValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end" />

        <TextView
            android:id="@+id/proteinLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/protein" />

        <ProgressBar
            android:id="@+id/proteinBar" android:progressTint="?attr/progressProtein" android:progressBackgroundTint="?attr/progressTrack"
            style="?android:attr/progressBarStyleHorizontal" android:minHeight="14dp" android:progressDrawable="@drawable/progress_rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/proteinValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end" />

        <TextView
            android:id="@+id/fatLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fat" />

        <ProgressBar
            android:id="@+id/fatBar" android:progressTint="?attr/progressFat" android:progressBackgroundTint="?attr/progressTrack"
            style="?android:attr/progressBarStyleHorizontal" android:minHeight="14dp" android:progressDrawable="@drawable/progress_rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/fatValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end" />

        <TextView
            android:id="@+id/carbsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/carbs" />

        <ProgressBar
            android:id="@+id/carbsBar" android:progressTint="?attr/progressCarbs" android:progressBackgroundTint="?attr/progressTrack"
            style="?android:attr/progressBarStyleHorizontal" android:minHeight="14dp" android:progressDrawable="@drawable/progress_rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/carbsValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end" />

        <Button style="@style/AppButton"
            android:id="@+id/addEntryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_product" />

        <Button style="@style/AppButton"
            android:id="@+id/addDishButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/build_dish" />

        <Button style="@style/AppButton"
            android:id="@+id/continueDishButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/continue_dish" />

        <LinearLayout
            android:id="@+id/entryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
